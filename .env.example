# ---- chung ----
# dev | staging | prod
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://bonsai:bonsai@postgres:5432/bonsai
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=bonsai
POSTGRES_PASSWORD=bonsai
POSTGRES_DB=bonsai

# ---- api ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
TRIAL_CREDITS=1
PHASE_A_DAILY_LIMIT=10

# ---- api: chia sẻ, quản trị, thanh toán ----
# Bật khi origin chỉ nhận traffic qua Cloudflare (giới hạn tần suất theo IP thật CF-Connecting-IP)
TRUST_CLOUDFLARE=false
# domain thật khi deploy (link /s/{code}, ảnh OG)
PUBLIC_BASE_URL=http://localhost:8080
# email (Google/dev) được quyền /admin, cách nhau dấu phẩy
ADMIN_EMAILS=
# mã BIN ngân hàng nhận tiền (vd. 970436 Vietcombank) cho VietQR
BANK_BIN=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=
# webhook SePay gửi header "Authorization: Apikey <key>"
SEPAY_API_KEY=
# webhook Casso gửi header "Secure-Token: <token>"
CASSO_SECURE_TOKEN=

# ---- lưu trữ R2 (api + worker). Chạy local không có R2: xem s3-local (SeaweedFS) trong infra/docker-compose.yml ----
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bonsai-private
PRESIGN_TTL_SECONDS=3600

# ---- chỉ worker: khóa AI (KHÔNG đưa vào api/web) ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-flash-latest
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_FALLBACK_PROVIDER=openai
IMAGE_FALLBACK_MODEL=gpt-image-1

# ---- giám sát (tuần 6) ----
# api + worker
SENTRY_DSN=
# web (build-time)
VITE_SENTRY_DSN=
# bot gửi cảnh báo: lỗi > 10%/giờ, chi phí ngày vượt ngưỡng, hàng đợi > 50
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_COST_ALERT_USD=20

# ---- web (build-time) ----
VITE_API_BASE=/api/v1
VITE_GOOGLE_CLIENT_ID=
VITE_ZALO_APP_ID=
# form đăng nhập bằng email thử; đặt false ở staging/prod
VITE_DEV_LOGIN=true
