# ---- chung ----
APP_ENV=dev                      # dev | staging | prod
DATABASE_URL=postgresql+psycopg://bonsai:bonsai@postgres:5432/bonsai
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=bonsai
POSTGRES_PASSWORD=bonsai
POSTGRES_DB=bonsai

# ---- api ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
TRIAL_CREDITS=1
PHASE_A_DAILY_LIMIT=10

# ---- lưu trữ R2 (api + worker). Chạy local không có R2: xem s3-local (SeaweedFS) trong infra/docker-compose.yml ----
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bonsai-private
PRESIGN_TTL_SECONDS=3600

# ---- chỉ worker: khóa AI (KHÔNG đưa vào api/web) ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-flash-latest
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_FALLBACK_PROVIDER=openai
IMAGE_FALLBACK_MODEL=gpt-image-1

# ---- web (build-time) ----
VITE_API_BASE=/api/v1
VITE_GOOGLE_CLIENT_ID=
VITE_ZALO_APP_ID=
VITE_DEV_LOGIN=true               # form đăng nhập bằng email thử; đặt false ở staging/prod
